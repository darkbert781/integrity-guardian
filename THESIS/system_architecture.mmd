graph TD
    %% System Architecture Diagram - Integrity Guardian
    
    subgraph Presentation_Layer["Tier 4: Presentation & Administration Layer"]
        UI["React 18 Dashboard<br/>(Vite + Tailwind CSS)"]
        FEED["Real-Time Security Feed<br/>(Event & Alert Telemetry)"]
        REG["File Registry & ACL Controls<br/>(Instant Lock / Unlock Toggle)"]
        MODAL["ACL Manager & Password Modal<br/>(icacls Inspector & Key Badges)"]
    end

    subgraph API_Layer["Tier 3: Asynchronous REST API Service Layer"]
        API["FastAPI Web Engine<br/>(Uvicorn ASGI Server)"]
        AUTH["Authentication Controller<br/>(MFA, Email OTP, JWT Tokens)"]
        RATE["Security Middleware<br/>(CORS, Rate Limiting, Input Sanitize)"]
        AUDIT_REC["Audit Trail Dispatcher<br/>(Structured Activity Logging)"]
    end

    subgraph Daemon_Layer["Tier 2: Core Security Daemon Layer"]
        WATCH["Watchdog Filesystem Observer<br/>(Background Polling Thread)"]
        ETW["Kernel ETW Consumer<br/>(ReadDirectoryChangesW)"]
        HASH["Cryptographic Hash Engine<br/>(SHA-256 64KB Block Chunking)"]
        ACL["Access Controller<br/>(Programmatic icacls Manager)"]
        VAULT["Rollback Engine<br/>(AES-256-GCM Snapshot Vault)"]
        ALERT["Alert Dispatcher<br/>(Twilio SMS & Resend Email)"]
    end

    subgraph Kernel_Storage_Layer["Tier 1: OS Kernel & Encrypted Storage Layer"]
        NTFS["Windows NTFS Subsystem<br/>(DACL / Security Descriptors)"]
        DB[("Encrypted SQLCipher Database<br/>(AES-256 Storage: Baselines & Audit)")]
        VDIR[("Encrypted Vault Archive<br/>(Compressed Mirror Snapshots)")]
        CONFIG["HMAC-Signed Config Store<br/>(ig-config.json)"]
    end

    subgraph External_Services["External Cloud & Gateways"]
        RESEND["Resend Email API<br/>(2FA & Critical Security Alerts)"]
        TWILIO["Twilio Gateway<br/>(Emergency SMS Notifications)"]
    end

    %% Connections
    UI <-->|HTTP/REST & Bearer Auth| API
    FEED <-->|Event Polling & Websockets| API
    REG <-->|Asset Registration & ACL State| API
    MODAL <-->|Unlock Password Verification| API

    API --> AUTH
    API --> RATE
    API --> AUDIT_REC

    API <-->|Service Calls| Daemon_Layer
    WATCH -->|I/O File Change Interception| NTFS
    ETW -->|Kernel I/O Event Intercept| NTFS
    ACL -->|Enforce DENY Write: Everyone:W,AD,WEA,WA| NTFS

    HASH <-->|Query & Update Hashes| DB
    VAULT <-->|Store / Restore Snapshots| VDIR
    AUDIT_REC -->|Append Immutable Audit Records| DB
    ACL -->|Verify & Hash Unlock Password| DB
    HASH -->|HMAC-SHA256 Integrity Verification| CONFIG

    ALERT -->|HTTPS API Dispatch| RESEND
    ALERT -->|HTTPS API Dispatch| TWILIO

    %% Styling
    classDef presentation fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#ffffff;
    classDef api fill:#0f172a,stroke:#818cf8,stroke-width:2px,color:#ffffff;
    classDef daemon fill:#134e4a,stroke:#2dd4bf,stroke-width:2px,color:#ffffff;
    classDef kernel fill:#312e81,stroke:#a78bfa,stroke-width:2px,color:#ffffff;
    classDef ext fill:#451a03,stroke:#fb923c,stroke-width:2px,color:#ffffff;

    class UI,FEED,REG,MODAL presentation;
    class API,AUTH,RATE,AUDIT_REC api;
    class WATCH,ETW,HASH,ACL,VAULT,ALERT daemon;
    class NTFS,DB,VDIR,CONFIG kernel;
    class RESEND,TWILIO ext;
